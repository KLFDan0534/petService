# ============================================================
# 环境变量模板（复制为 .env 并填入真实值，.env 已被 git 忽略）
# 后端通过 spring.config.import=optional:file:.env 自动加载
# ============================================================

# --- AI：智能下单 / AI助手（agent）与智能客服（cs）---
ZHIPU_API_KEY=replace-with-your-api-key
ZHIPU_MODEL=glm-5.3-flash
ZHIPU_ENDPOINT=https://api.b.ai/v1
ZHIPU_MAX_TOKENS=8192
ZHIPU_TEMPERATURE=1.0

KENARI_API_KEY=replace-with-your-api-key
KENARI_MODEL=glm-5.3-flash
KENARI_ENDPOINT=https://api.b.ai/v1
KENARI_MAX_TOKENS=8192
KENARI_TEMPERATURE=1.0

# --- 数据库（本地开发默认）---
MYSQL_URL=jdbc:mysql://localhost:3308/pet_service?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-your-db-password

# --- JWT 签名密钥（必填，至少 32 字符随机串，勿用示例值）---
JWT_SECRET=replace-with-a-long-random-secret-key
# access-token-expiration / refresh-token-expiration 见 application.yml

# --- Cloudflare Turnstile 人机校验（可选）---
TURNSTILE_SECRET=replace-with-your-turnstile-secret
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# --- Spring Security 基础认证（可选）---
SPRING_SECURITY_PASSWORD=replace-me

# --- 高德地图（前端定位/POI，可选）---
GAO_MAP_API_KEY=replace-with-your-gaode-js-api-key
GAO_MAP_SECURITY_CODE=
GAO_MAP_HANDOVER_RADIUS_METERS=500
GAO_MAP_ATTENDANCE_RADIUS_METERS=300

# --- MinIO（可选，默认 minioadmin/minioadmin）---
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin