root = true

# 统一使用 UTF-8, 避免中文乱码 (历史出现过 GBK / 双重编码问题)
[*]
charset = utf-8
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{java,xml,sql,yml,yaml,json,properties,ts,tsx,js,vue}]
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
